<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page" wx:if="{{book}}">
  <view class="detail-top">
    <view class="back" bindtap="back">‹ 返回</view>
    <view class="top-actions">
      <view class="icon-btn" bindtap="download">↓</view>
      <view class="icon-btn" bindtap="toggleMenu">···</view>
    </view>
    <view class="menu" wx:if="{{menuOpen}}">
      <view class="menu-item" bindtap="markFinished">✓ {{book.progress && book.progress.finished ? '标记为未完成' : '标记为已完成'}}</view>
      <view class="menu-item" bindtap="addToPlaylist">∞ 添加到播放清单</view>
    </view>
  </view>

  <image src="{{book.coverUrl}}" class="cover" mode="aspectFill" />
  <view class="h1 title">{{book.title}}</view>
  <view class="author" bindtap="toAuthor">来自 {{book.author || '未知主播'}} ›</view>

  <button class="button primary" bindtap="play">▶ {{book.progress && !book.progress.finished ? '继续聆听' : (book.progress && book.progress.finished ? '重新播放' : '开始聆听')}}</button>

  <view class="media-wrap" bindtap="toggleMedia">
    <view class="media-cards" wx:if="{{mediaGroup === 0}}">
      <view class="media-card"><view class="muted">长度</view><view class="mv">{{length.hours}} 小时</view><view class="muted">{{length.minutes}} 分钟</view></view>
      <view class="media-card"><view class="muted">文件大小</view><view class="mv">{{media.sizeText}}</view></view>
      <view class="media-card"><view class="muted">码率</view><view class="mv">{{media.bitrate || '—'}}</view><view class="muted">kbps</view></view>
    </view>
    <view class="media-cards" wx:else>
      <view class="media-card"><view class="muted">码率</view><view class="mv">{{media.bitrate || '—'}}</view><view class="muted">kbps</view></view>
      <view class="media-card"><view class="muted">编码</view><view class="mv">{{media.codec}}</view></view>
      <view class="media-card"><view class="muted">格式</view><view class="mv">{{media.format}}</view></view>
    </view>
    <view class="media-dots"><view class="dot {{mediaGroup === 0 ? 'active' : ''}}"></view><view class="dot {{mediaGroup === 1 ? 'active' : ''}}"></view></view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'chapters' ? 'active' : ''}}" data-tab="chapters" bindtap="setTab">章节</view>
    <view class="tab {{tab === 'bookmarks' ? 'active' : ''}}" data-tab="bookmarks" bindtap="setTab">书签</view>
    <view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="setTab">历史记录</view>
  </view>

  <view wx:if="{{tab === 'chapters'}}" class="chapter-list">
    <view class="chapter" wx:for="{{book.chapters}}" wx:key="id" bindtap="toChapter" data-index="{{index}}">
      <view class="muted">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</view>
      <view class="chapter-title">{{item.title}}</view>
      <view class="muted">{{fmt.time(item.duration)}}</view>
    </view>
  </view>

  <view wx:if="{{tab === 'bookmarks'}}" class="bookmark-list">
    <view class="chapter" wx:for="{{bookmarks}}" wx:key="id">
      <view class="chapter-title">{{item.title || '书签'}}</view>
      <view class="muted">{{fmt.time(item.position)}}</view>
    </view>
    <view wx:if="{{!bookmarks.length}}" class="empty-state">🔖 没有书签</view>
  </view>

  <view wx:if="{{tab === 'history'}}" class="history-list">
    <view wx:for="{{historyByDay}}" wx:key="day" wx:for-item="group">
      <view class="history-day">{{group.day}}</view>
      <view class="history-row" wx:for="{{group.events}}" wx:key="id" wx:for-item="event">
        <view class="history-time">{{event.time}}</view>
        <view class="history-kind {{event.kind === 'added' ? 'added' : ''}}">{{event.kind === 'added' ? '+' : '▶'}}</view>
        <view class="history-info"><view>{{event.label}}</view><view class="muted">{{event.bookTitle}}</view></view>
      </view>
    </view>
    <view wx:if="{{!historyByDay.length}}" class="empty-state">还没有收听记录</view>
  </view>
</view>
