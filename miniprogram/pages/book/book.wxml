<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page" wx:if="{{book}}">
  <image src="{{book.coverUrl}}" mode="aspectFill" style="width:360rpx;height:540rpx;border-radius:20rpx;margin:20rpx auto 30rpx;display:block" />
  <view class="h1" style="text-align:center">{{book.title}}</view>
  <view style="text-align:center;font-family:Georgia,serif;margin-top:10rpx">{{book.author || '未知作者'}}</view>
  <view class="muted" style="text-align:center;margin-top:6rpx">由 {{book.narrator || '未知演播者'}} 演播</view>
  <button class="button" style="margin-top:32rpx" bindtap="play">▶ {{book.progress && !book.progress.finished ? '继续播放' : '开始播放'}}</button>

  <view class="row between" style="margin-top:36rpx">
    <view class="h2">章节</view>
    <view class="muted">{{chapterCount}} 章</view>
  </view>
  <view class="chapter" wx:for="{{book.chapters}}" wx:key="id" bindtap="toChapter" data-index="{{index}}">
    <view class="muted">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</view>
    <view class="chapter-title">{{item.title}}</view>
    <view class="muted">{{fmt.time(item.duration)}}</view>
  </view>

  <view class="card" style="margin-top:30rpx">
    <view class="muted">简介</view>
    <view style="font-size:26rpx;line-height:1.7;margin-top:12rpx">{{book.description || '暂无简介'}}</view>
  </view>
</view>
