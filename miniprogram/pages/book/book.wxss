.detail-top { display:flex; align-items:center; justify-content:space-between; position:relative; }
.back { color:#c99b72; font-size:28rpx; padding:12rpx 0; }
.top-actions { display:flex; gap:16rpx; }
.icon-btn { width:64rpx; height:64rpx; border-radius:50%; background:#2a2a2c; color:#eee;
  display:flex; align-items:center; justify-content:center; font-size:32rpx; }
.menu { position:absolute; right:0; top:80rpx; z-index:20; background:#2b2b2d; border:1rpx solid #3a3937;
  border-radius:16rpx; min-width:320rpx; box-shadow:0 12rpx 40rpx rgba(0,0,0,.5); overflow:hidden; }
.menu-item { padding:26rpx 28rpx; font-size:28rpx; border-bottom:1rpx solid #37363a; }
.menu-item:last-child { border-bottom:0; }
.cover { width:440rpx; height:440rpx; border-radius:24rpx; display:block; margin:16rpx auto 26rpx; }
.title { text-align:center; font-size:38rpx; font-weight:600; }
.author { text-align:center; color:#9a9a9a; font-size:26rpx; margin-top:12rpx; }
.button.primary { background:#c99b72; color:#1a1410; font-weight:600; margin:32rpx 0 8rpx; }
.media-wrap { margin:24rpx 0; }
.media-cards { display:flex; gap:16rpx; }
.media-card { flex:1; background:#202022; border-radius:16rpx; padding:24rpx 10rpx; text-align:center;
  display:flex; flex-direction:column; gap:8rpx; min-width:0; }
.muted { color:#8b8b8b; font-size:22rpx; }
.mv { font-size:34rpx; font-weight:600; font-family:Georgia,serif; }
.media-dots { display:flex; justify-content:center; gap:10rpx; margin-top:16rpx; }
.dot { width:10rpx; height:10rpx; border-radius:50%; background:#555; }
.dot.active { width:32rpx; border-radius:6rpx; background:#c99b72; }
.tabs { display:flex; gap:8rpx; background:#242426; border-radius:24rpx; padding:6rpx; margin:24rpx 0; }
.tab { flex:1; text-align:center; padding:16rpx 0; font-size:26rpx; color:#9a9a9a; border-radius:20rpx; }
.tab.active { background:#3a3937; color:#fff; font-weight:600; }
.chapter { display:flex; align-items:center; gap:20rpx; padding:24rpx 6rpx; border-bottom:1rpx solid #302f2d; }
.chapter-title { flex:1; font-size:26rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.empty-state { text-align:center; color:#8b8b8b; font-size:28rpx; padding:80rpx 0; }
.history-day { color:#8b8b8b; font-size:24rpx; margin:24rpx 0 12rpx; }
.history-row { display:flex; align-items:center; gap:18rpx; background:#202022; border-radius:16rpx; padding:22rpx; margin-bottom:12rpx; }
.history-time { background:#2b2b2d; color:#9a9a9a; font-size:22rpx; padding:10rpx 14rpx; border-radius:10rpx; }
.history-kind { color:#9a9a9a; font-size:30rpx; }
.history-kind.added { color:#57c98a; }
.history-info { flex:1; font-size:26rpx; display:flex; flex-direction:column; gap:6rpx; }
