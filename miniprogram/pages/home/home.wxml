<view class="page">
  <view class="muted">SOUNDSHELF</view>
  <view class="h1">首页</view>
  <view class="muted" style="margin-top:8rpx">继续你的聆听旅程</view>

  <view class="row" style="gap:20rpx;margin:30rpx 0">
    <view class="card" style="flex:1">
      <view class="muted">本周收听</view>
      <view class="h2 accent">{{stats.weekSeconds ? (stats.weekSeconds/3600).toFixed(1)+' 小时' : '0 小时'}}</view>
    </view>
    <view class="card" style="flex:1">
      <view class="muted">连续收听</view>
      <view class="h2 accent">{{stats.streak || 0}} 天</view>
    </view>
  </view>

  <view class="h2">继续收听</view>
  <view wx:if="{{continueList.length}}">
    <view class="book-row" wx:for="{{continueList}}" wx:key="id" bindtap="toBook" data-id="{{item.id}}">
      <image class="cover" style="width:108rpx;height:108rpx" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="muted">{{item.author || '未知作者'}}</view>
        <view class="accent" style="font-size:22rpx;margin-top:8rpx" catchtap="play" data-id="{{item.id}}">▶ 继续播放</view>
      </view>
    </view>
  </view>
  <view wx:else class="empty">开始播放一本书后，这里会显示进度</view>

  <view class="h2" style="margin-top:36rpx">最近添加</view>
  <scroll-view scroll-x class="cover-scroll">
    <view class="cover-item" wx:for="{{recent}}" wx:key="id" bindtap="toBook" data-id="{{item.id}}">
      <image src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="name">{{item.title}}</view>
    </view>
  </scroll-view>

  <view class="h2">已听完</view>
  <scroll-view scroll-x class="cover-scroll">
    <view class="cover-item" wx:for="{{finished}}" wx:key="id" bindtap="toBook" data-id="{{item.id}}">
      <image src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="name">{{item.title}}</view>
    </view>
  </scroll-view>
</view>
