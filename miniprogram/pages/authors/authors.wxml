<view class="page">
  <view class="muted">SOUNDSHELF</view>
  <view class="h1">作者</view>
  <input class="input" style="margin-top:24rpx" placeholder="搜索作者" bindinput="onSearch" />
  <view wx:for="{{authors}}" wx:key="name" class="author-row" bindtap="toAuthor" data-name="{{item.name}}">
    <image class="author-avatar" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="info">
      <view class="title">{{item.name}}</view>
      <view class="muted" style="font-size:22rpx">{{item.bookCount}} 本书籍</view>
    </view>
    <view class="accent">›</view>
  </view>
  <view wx:if="{{!authors.length}}" class="empty">没有匹配的作者</view>
</view>
