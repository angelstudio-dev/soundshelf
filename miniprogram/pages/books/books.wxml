<view class="page">
  <view class="muted">SOUNDSHELF</view>
  <view class="h1">书籍</view>
  <input class="input" style="margin-top:24rpx" placeholder="筛选书名或作者" bindinput="onSearch" />
  <view style="margin-bottom:16rpx">
    <view class="chip {{filter === item.key ? 'active' : ''}}" wx:for="{{filters}}" wx:key="key"
      bindtap="setFilter" data-key="{{item.key}}">{{item.label}}</view>
  </view>
  <view class="book-row" wx:for="{{books}}" wx:key="id" bindtap="toBook" data-id="{{item.id}}">
    <image class="cover" style="width:108rpx;height:160rpx" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="info">
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.author || '未知作者'}}</view>
      <view class="accent" wx:if="{{item.progress && !item.progress.finished}}" style="font-size:22rpx;margin-top:8rpx">已收听 {{item.progress.position ? Math.round(item.progress.position/item.duration*100) : 0}}%</view>
    </view>
  </view>
  <view wx:if="{{!books.length}}" class="empty">没有匹配的书籍</view>
</view>
