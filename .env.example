# 服务监听
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 至少 32 字符的随机密钥，用于签名访问令牌：openssl rand -hex 32
JWT_SECRET=replace_with_a_random_32_byte_secret

# SQLite 数据库文件路径（请挂载到宿主目录）
DATABASE_PATH=/app/data/soundshelf.sqlite

# 允许的前端来源，逗号分隔。生产环境不要使用 *
CORS_ORIGINS=http://localhost:5173

# 首次启动创建的管理员账户（仅首次生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# 演示模式：无书源时填充示例书籍，方便体验 UI
DEMO_MODE=true

# 跳过启动时的书源自动同步（已有数据库、只想重启 UI 时设为 true）
SKIP_STARTUP_SYNC=false

# Audiobookshelf 书源（可留空，之后在设置页添加）
ABS_BASE_URL=
ABS_TOKEN=

# Plex 书源（可留空，之后在设置页添加）
PLEX_BASE_URL=
PLEX_TOKEN=
PLEX_LIBRARY_TITLE=Audiobooks

# 本地目录书源：容器内挂载路径，逗号分隔
LOCAL_LIBRARY_PATHS=/media/books

# 日志级别
LOG_LEVEL=info

# 转录服务（可选，留空则转录功能不可用）
TRANSCRIPT_PROVIDER=none
TRANSCRIPT_COMMAND=
